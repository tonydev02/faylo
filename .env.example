# Public Supabase project URL and publishable key. Safe for browser use; this app uses them server-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Canonical origin only; OAuth always returns to this configured origin.
APP_URL=http://localhost:3000

# Private server-only allowlist: exact Supabase Auth user UUID approved for Faylo.
# Leave blank until the first Google sign-in creates the user; copy its UUID from Supabase Auth > Users.
SUPABASE_OWNER_USER_ID=
